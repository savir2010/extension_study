{
  "manifest_version": 3,
  "name": "Study Helper Extension",
  "version": "1.0",
  "description": "Convert any text into flashcards and quizzes for studying",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://localhost:5000/*",
    "*://*.ngrok-free.app/*",
    "*://*.ngrok.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Study Helper"
  },
  "icons": {
    "16": "image.png",
    "64": "64.png",
    "128": "128.png"
  }
}